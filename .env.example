ASTRO_ENV=dev
# Production uses PostgreSQL 16 (psycopg3 driver); local dev/unit tests may use SQLite
ASTRO_DATABASE_URL=postgresql+psycopg://astro:astro_dev_only@localhost:5432/astroplan
ASTRO_EPHE_PATH=./ephe
ASTRO_REQUIRE_SWISS_FILES=false
ASTRO_ALLOW_DRAFT_RULES=true
ASTRO_AUTH_MODE=dev
ASTRO_FIELD_ENCRYPTION_KEYS=
ASTRO_SHARE_TOKEN_SECRET=dev-share-secret-change-in-production
ASTRO_OPERATOR_API_KEY=dev-operator-key
ASTRO_GEOCODE_PROVIDER=nominatim
ASTRO_GEOCODE_USER_AGENT=astroplan-beta/3.6 (contact: grievance@astroplan.in)
ASTRO_LLM_ENABLED=false
ASTRO_LLM_REPHRASE_ENABLED=false
# Leave ASTRO_LLM_PROVIDERS unset so OPENROUTER_API_KEY tries the models below first,
# then Gemini, Gemma, and Anthropic when those keys exist. Set it to lock the order.
# A missing key is skipped. 429, quota, unknown-model 404, 5xx, timeout, and
# connection errors try the next model. A blocked promise tries one later model.
# ASTRO_LLM_PROVIDERS=gemini,gemma,anthropic
# Gemini and Gemma share one Google AI Studio key. Any one of these names works:
# ASTRO_GEMINI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY, GOOGLE_AI_API_KEY, GEMMA_API_KEY
ASTRO_GEMINI_API_KEY=
ASTRO_GEMINI_MODEL=gemini-3.8-flash
ASTRO_GEMMA_MODEL=gemma-4-31b-it
ASTRO_ANTHROPIC_API_KEY=
ASTRO_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN are also accepted.
# ANTHROPIC_AUTH_TOKEN is sent as a bearer token and uses ANTHROPIC_BASE_URL when that URL is https.
# ASTRO_ANTHROPIC_BASE_URL=
# Direct keys are used after OpenRouter, and only when set. On the default list,
# OPENAI_API_KEY or ASTRO_OPENAI_API_KEY and GROQ_API_KEY or ASTRO_GROQ_API_KEY
# are inserted after Gemma.
# One OpenRouter key for every model below: OPENROUTER_API_KEY or ASTRO_OPENROUTER_API_KEY.
# ASTRO_OPENAI_BASE_URL=https://api.openai.com/v1
# ASTRO_OPENAI_MODEL=gpt-4o-mini
# ASTRO_GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated ids. Change this string to replace a retired model. :free only
# where OpenRouter lists that variant. Gemini 4 Hydrogen is tried first, then
# GPT-6.2 Sol, then Claude Sonnet 5.5. The free ids are the fallback. None of
# these paid ids has a :free variant.
ASTRO_OPENROUTER_MODELS=google/gemini-4-hydrogen,openai/gpt-6.2-sol,anthropic/claude-sonnet-5.5,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openai/gpt-oss-120b:free
# ASTRO_OPENROUTER_MODEL is used only when ASTRO_OPENROUTER_MODELS is empty.
ASTRO_LLM_MONTHLY_CALL_CAP=1000
ASTRO_LEGAL_GATE_APPROVED=false
ASTRO_LEGAL_GATE_REFERENCE=
# AGPL-3.0 network-use source offer; production requires an https URL.
ASTRO_SOURCE_OFFER_URL=
ASTRO_GRIEVANCE_OFFICER_NAME=Meera Deshmukh
ASTRO_GRIEVANCE_OFFICER_EMAIL=grievance@astroplan.in
ASTRO_GRIEVANCE_RESPONSE_SLA_HOURS=72
